<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Wise Sample</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UILaunchScreen</key><dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
	<key>UIBackgroundModes</key><array><string>audio</string></array>
	<!-- Required by the Zoom SDK (iOS stops the app / App Store rejects the upload without them). -->
	<key>NSCameraUsageDescription</key><string>Your camera is used to share video in live classes.</string>
	<key>NSMicrophoneUsageDescription</key><string>Your microphone is used to speak in live classes.</string>
	<key>NSBluetoothAlwaysUsageDescription</key><string>Bluetooth is used for audio devices in live classes.</string>
	<key>NSPhotoLibraryUsageDescription</key><string>Photos can be shared in live classes.</string>
	<key>NSPhotoLibraryAddUsageDescription</key><string>Photos from live classes can be saved to your gallery.</string>
	<key>NSCalendarsUsageDescription</key><string>Calendar permission is used to access scheduled meetings from your calendar.</string>
	<key>NSCalendarsFullAccessUsageDescription</key><string>Calendar permission is used to access scheduled meetings from your calendar.</string>
	<key>NSContactsUsageDescription</key><string>Contacts permission is used to invite participants from your contacts list.</string>
	<key>NSLocationWhenInUseUsageDescription</key><string>Location is used only if you choose to share it during a live class.</string>
	<!-- Screen share: read by the app (ViewController) from Config.xcconfig values. -->
	<key>WiseAppGroup</key><string>$(WISE_APP_GROUP)</string>
	<key>WiseScreenShareBundleId</key><string>$(WISE_SCREENSHARE_BUNDLE_ID)</string>
</dict>
</plist>
